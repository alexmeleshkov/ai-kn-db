#!/usr/bin/env bash
set -euo pipefail

PROMPT="${PROJECT_PROMPT:-${1:-}}"
if [ -z "${PROMPT}" ] && [ ! -t 0 ]; then
  PROMPT="$(cat)"
fi
if [ -z "${PROMPT}" ]; then
  echo 'Usage: PROJECT_PROMPT="User can ..." ./scripts/new-project'
  echo '   or: ./scripts/new-project "User can ..."'
  exit 1
fi

TS="$(date +%s)"
SLUG="$(echo "$PROMPT" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9 ' | tr ' ' '-' | cut -c1-40)"
OUT_DIR="generated/${SLUG:-project}-${TS}"

echo "==> prompt: $PROMPT"
echo "==> out_dir: $OUT_DIR"

mkdir -p "$OUT_DIR"
python3 scripts/kb/generate_from_kb.py --prompt "$PROMPT" --out-dir "$OUT_DIR" --run-smoke

echo "==> generated: $OUT_DIR"
